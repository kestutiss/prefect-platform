FROM prefecthq/prefect:3.7.5-python3.12@sha256:f7e11177bedd798fe193393ee22d50531ecadae207158e6333a9237bd2891335

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake flow code into image — deps are cached separately so this layer is fast
COPY flows/ ./flows/
COPY tasks/ ./tasks/
COPY prefect.yaml .

COPY entrypoint.sh /entrypoint.sh
# Normalize line endings (safe on Linux, required when built on Windows)
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

CMD ["/entrypoint.sh"]
